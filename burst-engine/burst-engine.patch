+package downloaders
+
+import (
+	"context"
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/operations"
+	"github.com/rclone/rclone/fstest"
+	"github.com/rclone/rclone/lib/ranges"
+	"github.com/rclone/rclone/lib/readers"
+	"github.com/rclone/rclone/vfs/vfscommon"
+	"github.com/stretchr/testify/require"
+	"io"
+	"testing"
+	"time"
+)
+
+func TestBurstRefill(t *testing.T) {
+	r := fstest.NewRun(t)
+	const MiB = int64(1024 * 1024)
+	const size = 64 * MiB
+	ctx := context.Background()
+	src, err := operations.RcatSize(ctx, r.Fremote, "burst-test.bin", io.NopCloser(readers.NewPatternReader(size)), size, time.Now(), nil)
+	require.NoError(t, err)
+	item := &testItem{t: t, size: size}
+	opt := vfscommon.Opt
+	opt.ReadAhead = fs.SizeSuffix(16 * MiB)
+	opt.ReadAheadLowWater = fs.SizeSuffix(4 * MiB)
+	dls := New(ctx, item, &opt, "burst-test.bin", src)
+	defer func() { require.NoError(t, dls.Close(nil)) }()
+	require.NoError(t, dls.Download(ranges.Range{Pos: 0, Size: 1}))
+	require.Eventually(t, func() bool { return item.HasRange(ranges.Range{Pos: 0, Size: 16 * MiB}) }, 10*time.Second, 10*time.Millisecond)
+	// A cached read well above low water must not extend the target.
+	dls.mu.Lock()
+	before := dls.dls[0].maxOffset
+	dls.mu.Unlock()
+	require.NoError(t, dls.EnsureDownloader(ranges.Range{Pos: 3 * MiB, Size: 1}))
+	dls.mu.Lock()
+	after := dls.dls[0].maxOffset
+	dls.mu.Unlock()
+	require.Equal(t, before, after)
+	// A read near the cached tail refills the high window.
+	require.NoError(t, dls.EnsureDownloader(ranges.Range{Pos: 13 * MiB, Size: 1}))
+	require.Eventually(t, func() bool { return item.HasRange(ranges.Range{Pos: 13 * MiB, Size: 16 * MiB}) }, 10*time.Second, 10*time.Millisecond)
+	// Seek outside cached coverage must not wait for a refill timer.
+	require.NoError(t, dls.Download(ranges.Range{Pos: 50 * MiB, Size: 1024}))
+	require.True(t, item.HasRange(ranges.Range{Pos: 50 * MiB, Size: 1024}))
+	// Invalid lower threshold fails instead of silently starving a reader.
+	bad := opt
+	bad.ReadAheadLowWater = bad.ReadAhead
+	invalid := New(ctx, &testItem{t: t, size: size}, &bad, "burst-test.bin", src)
+	require.Error(t, invalid.EnsureDownloader(ranges.Range{Pos: 0, Size: 1}))
+	require.NoError(t, invalid.Close(nil))
+}
