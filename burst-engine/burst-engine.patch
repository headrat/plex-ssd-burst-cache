 // call with lock held
 func (dls *Downloaders) _ensureDownloader(r ranges.Range) (err error) {
 	// defer log.Trace(dls.src, "r=%v", r)("err=%v", &err)
+
+	// Keep a filled SSD window quiet until its contiguous cached coverage
+	// falls below the lower threshold. Missing demanded bytes always bypass
+	// this gate, so seeks and independent readers retain normal behavior.
+	// This is per object/range; no global stop or bandwidth throttle is used.
+	if low := int64(dls.opt.ReadAheadLowWater); low != 0 {
+		if low < 0 || low >= int64(dls.opt.ReadAhead) {
+			return errors.New("vfs-read-ahead-low-water must be positive and less than vfs-read-ahead")
+		}
+		lowRange := r
+		lowRange.Size += low
+		if dls.item.FindMissing(lowRange).IsEmpty() {
+			return nil
+		}
+	}
 
